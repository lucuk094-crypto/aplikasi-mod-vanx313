{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/home.html"
    },
    {
      "src": "/index.html",
      "dest": "/home.html"
    },
    {
      "src": "/admin",
      "dest": "/adminlogin.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashbordadmin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
