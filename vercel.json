{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/index.html",
      "destination": "/home.html"
    },
    {
      "source": "/admin",
      "destination": "/adminlogin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashbordadmin.html"
    }
  ]
}
