{
  "version": 2,
  "name": "vanmod-website",
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/home.html"
    },
    {
      "src": "/admin",
      "dest": "/adminlogin.html"
    },
    {
      "src": "/(.*).html",
      "dest": "/$1.html"
    }
  ]
}
