{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/home.html",
      "dest": "/home.html"
    },
    {
      "src": "/apps.html",
      "dest": "/apps.html"
    },
    {
      "src": "/games.html",
      "dest": "/games.html"
    },
    {
      "src": "/tools.html",
      "dest": "/tools.html"
    },
    {
      "src": "/detailapp.html",
      "dest": "/detailapp.html"
    },
    {
      "src": "/about.html",
      "dest": "/about.html"
    },
    {
      "src": "/contact.html",
      "dest": "/contact.html"
    },
    {
      "src": "/panduan.html",
      "dest": "/panduan.html"
    },
    {
      "src": "/adminlogin.html",
      "dest": "/adminlogin.html"
    },
    {
      "src": "/dashbordadmin.html",
      "dest": "/dashbordadmin.html"
    },
    {
      "src": "/adminsettings.html",
      "dest": "/adminsettings.html"
    },
    {
      "src": "/systemlogdetail.html",
      "dest": "/systemlogdetail.html"
    },
    {
      "src": "/transmissionsucces.html",
      "dest": "/transmissionsucces.html"
    },
    {
      "src": "/latest.html",
      "dest": "/latest.html"
    },
    {
      "src": "/popular.html",
      "dest": "/popular.html"
    },
    {
      "src": "/",
      "dest": "/home.html"
    }
  ],
  "env": {
    "FIREBASE_API_KEY": "@firebase_api_key",
    "FIREBASE_AUTH_DOMAIN": "@firebase_auth_domain",
    "FIREBASE_PROJECT_ID": "@firebase_project_id",
    "FIREBASE_STORAGE_BUCKET": "@firebase_storage_bucket",
    "FIREBASE_MESSAGING_SENDER_ID": "@firebase_messaging_sender_id",
    "FIREBASE_APP_ID": "@firebase_app_id"
  }
}
