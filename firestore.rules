rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = HANYA email terdaftar di bawah. Kalau mau tambah admin,
    // daftarkan di sini + samakan dengan ADMIN_EMAILS di web/src/config.js
    // dan adminEmails di app/lib/config/app_config.dart.
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'vanxmod313@gmail.com';
    }

    // Public visitors may only bump stats fields (download counter,
    // reviews + rating). All other fields are protected: any attempt to
    // change them makes affectedKeys() contain more than this allow-list
    // and the write is rejected.
    function isPublicStatsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['downloads', 'reviews', 'rating', 'updatedAt']);
    }

    // Apps collection - read public, write admin only,
    // except public stats updates (downloads / reviews)
    match /apps/{appId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isPublicStatsUpdate();
    }

    // Games collection - read public, write admin only,
    // except public stats updates (downloads / reviews)
    match /games/{gameId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isPublicStatsUpdate();
    }

    // Tools collection - read public, write admin only,
    // except public stats updates (downloads / reviews)
    match /tools/{toolId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isPublicStatsUpdate();
    }

    // Contacts collection - create public, read/update/delete admin only
    match /contacts/{contactId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Forum chat - baca publik, kirim wajib login (uid+email dicek),
    // hapus hanya pemilik pesan atau admin
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == resource.data.uid);
    }

    // Stats collection - read public, write admin only
    match /stats/{statId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
